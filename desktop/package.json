{
  "name": "cinelab-desktop",
  "productName": "Cinelab",
  "version": "1.0.3",
  "description": "Cinelab — free and open-source extension-based media centre for PC. Compatible with CloudStream repositories.",
  "author": "Su-borno7",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "dashjs": "5.3.0",
    "hls.js": "1.7.4"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "jsdom": "^31.0.1"
  },
  "build": {
    "appId": "com.cinelab.app",
    "productName": "Cinelab",
    "copyright": "Cinelab contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**/*",
      "!test/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../bridge/app/build/install/cinelab-bridge",
        "to": "bridge"
      },
      {
        "from": "build/jre",
        "to": "jre"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "executableName": "cinelab",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "Cinelab"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Cinelab"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Su-borno7/Skystream.git"
  },
  "desktopName": "Cinelab"
}
