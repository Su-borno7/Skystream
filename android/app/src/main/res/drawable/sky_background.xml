<?xml version="1.0" encoding="utf-8"?>
<!-- Première theme backdrop: warm graphite gradient, candle glow (top-right champagne), ember haze (bottom-left), faint umber clouds -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- deep navy, zenith -> faintly lit horizon (matches the website night palette) -->
    <item>
        <shape>
            <gradient android:type="linear" android:angle="270"
                      android:startColor="#0B0908" android:centerColor="#161210" android:endColor="#2E2412" />
        </shape>
    </item>

    <!-- cyan horizon lightening -->
    <item>
        <shape>
            <gradient android:type="linear" android:angle="90"
                      android:startColor="#00E0B15C" android:centerColor="#00E0B15C" android:endColor="#26E0B15C" />
        </shape>
    </item>

    <!-- violet haze, bottom-left (icon glow) -->
    <item android:gravity="bottom|left" android:bottom="-190dp" android:left="-190dp" android:width="620dp" android:height="620dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="310dp"
                      android:centerX="0.5" android:centerY="0.5"
                      android:startColor="#592E2417" android:centerColor="#292E2417" android:endColor="#002E2417" />
        </shape>
    </item>

    <!-- moon glow, top-right -->
    <item android:gravity="top|right" android:top="-190dp" android:right="-190dp" android:width="620dp" android:height="620dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="310dp"
                      android:centerX="0.5" android:centerY="0.5"
                      android:startColor="#E6FBF3DC" android:centerColor="#4DE0B15C" android:endColor="#00E0B15C" />
        </shape>
    </item>

    <!-- cloud cluster 1 (top-left, near horizon of the status bar) -->
    <item android:left="-70dp" android:top="54dp" android:width="300dp" android:height="120dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="150dp"
                      android:centerX="0.5" android:centerY="0.5"
                      android:startColor="#802E2419" android:centerColor="#472E2419" android:endColor="#002E2419" />
        </shape>
    </item>
    <item android:left="18dp" android:top="-6dp" android:width="150dp" android:height="110dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="75dp"
                      android:centerX="0.5" android:centerY="0.5"
                      android:startColor="#802E2419" android:centerColor="#402E2419" android:endColor="#002E2419" />
        </shape>
    </item>
    <item android:left="120dp" android:top="6dp" android:width="140dp" android:height="100dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="70dp"
                      android:centerX="0.5" android:centerY="0.5"
                      android:startColor="#732E2419" android:centerColor="#332E2419" android:endColor="#002E2419" />
        </shape>
    </item>

    <!-- cloud cluster 2 (mid-right) -->
    <item android:left="210dp" android:top="300dp" android:width="270dp" android:height="110dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="135dp"
                      android:centerX="0.5" android:centerY="0.5"
                      android:startColor="#732E2419" android:centerColor="#382E2419" android:endColor="#002E2419" />
        </shape>
    </item>
    <item android:left="300dp" android:top="250dp" android:width="140dp" android:height="100dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="70dp"
                      android:centerX="0.5" android:centerY="0.5"
                      android:startColor="#662E2419" android:centerColor="#2E2E2419" android:endColor="#002E2419" />
        </shape>
    </item>

    <!-- cloud cluster 3 (lower-left, faint) -->
    <item android:left="-40dp" android:top="620dp" android:width="260dp" android:height="100dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="130dp"
                      android:centerX="0.5" android:centerY="0.5"
                      android:startColor="#612E2419" android:centerColor="#2B2E2419" android:endColor="#002E2419" />
        </shape>
    </item>
    <item android:left="96dp" android:top="590dp" android:width="130dp" android:height="90dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="65dp"
                      android:centerX="0.5" android:centerY="0.5"
                      android:startColor="#552E2419" android:centerColor="#1F2E2419" android:endColor="#002E2419" />
        </shape>
    </item>
</layer-list>
