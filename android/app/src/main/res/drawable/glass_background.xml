<?xml version="1.0" encoding="utf-8"?>
<!-- Glass theme backdrop: deep-space gradient with two soft aurora glows (cyan + violet) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:type="linear" android:angle="135"
                      android:startColor="#17202F" android:endColor="#090E16" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:gradientRadius="1400"
                      android:centerX="0.85" android:centerY="0.08"
                      android:startColor="#57E0B15C" android:centerColor="#1FE0B15C" android:endColor="#00E0B15C" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:gradientRadius="1400"
                      android:centerX="0.1" android:centerY="0.95"
                      android:startColor="#4A8B5CF6" android:centerColor="#188B5CF6" android:endColor="#008B5CF6" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:gradientRadius="1100"
                      android:centerX="0.58" android:centerY="1.12"
                      android:startColor="#29F472B6" android:centerColor="#0DF472B6" android:endColor="#00F472B6" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="linear" android:angle="270"
                      android:startColor="#0AFFFFFF" android:endColor="#00FFFFFF"
                      android:centerColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
